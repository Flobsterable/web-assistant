# Windows gateway -> Ollama on the same Windows computer.
UPSTREAM_URL=http://127.0.0.1:11434
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# Generate a unique value, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LLM_API_KEY=replace-with-a-random-key-at-least-24-characters

# Basic limits enforced before a request reaches Ollama.
RATE_LIMIT_RPM=20
MAX_CONTEXT_TOKENS=8192
MAX_OUTPUT_TOKENS=600
MAX_BODY_BYTES=2097152
MAX_CONCURRENT_REQUESTS=2
QUEUE_LIMIT=8
UPSTREAM_TIMEOUT_MS=600000

# Used by smoke-test.mjs from the Mac. Not read by the gateway itself.
PUBLIC_LLM_BASE_URL=https://llm.example.com
TEST_MODEL=qwen3.5:9b
TEST_CONCURRENCY=4
