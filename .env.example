PORT=3001
DEFAULT_TASK=Объясни простыми словами, что такое градиентный бустинг, и приведи один пример применения.
AGENT_MAX_CONTEXT_MESSAGES=40
AGENT_MAX_CONTEXT_CHARACTERS=24000
MODEL_MAX_CONTEXT_TOKENS=40000
RAG_SEARCH_TOP_K=8
RAG_FILTERED_TOP_K=3
RAG_RELEVANCE_THRESHOLD=0.22

# Default assistant model. Set to "flash" to use DeepSeek instead.
AGENT_MODEL_ID=local

# Ollama on another computer in the same local network.
# Replace the example IPv4 address with the address of the Ollama computer.
MODEL_LOCAL_TITLE=Локальная: Qwen 3.5 9B
MODEL_LOCAL_BASE_URL=http://192.168.1.50:11434/v1
MODEL_LOCAL_NAME=qwen3.5:9b
MODEL_LOCAL_INPUT_PRICE_PER_1M=0
MODEL_LOCAL_OUTPUT_PRICE_PER_1M=0
MODEL_LOCAL_PRICE_CURRENCY=USD
MODEL_LOCAL_MAX_CONTEXT_TOKENS=8192
MODEL_LOCAL_RESERVED_OUTPUT_TOKENS=600
# Реальные параметры генерации, передаваемые в Ollama /api/chat.
MODEL_LOCAL_TEMPERATURE=0.1
MODEL_LOCAL_CONTEXT_WINDOW=8192
MODEL_LOCAL_MAX_OUTPUT_TOKENS=600
MODEL_LOCAL_TOP_P=0.9
MODEL_LOCAL_SEED=42

# A/B benchmark локальной модели. Укажите разные теги Ollama, чтобы сравнить квантование.
# Например, baseline может быть Q8, а optimized — Q4_K_M/Q5_K_M из доступных тегов модели.
MODEL_LOCAL_BASELINE_NAME=qwen3.5:9b
MODEL_LOCAL_BASELINE_TEMPERATURE=0.2
# Параметры context/max tokens намеренно отсутствуют: baseline воспроизводит старое поведение Ollama по умолчанию.
MODEL_LOCAL_OPTIMIZED_NAME=qwen3.5:9b
MODEL_LOCAL_OPTIMIZED_TEMPERATURE=0.1
MODEL_LOCAL_OPTIMIZED_CONTEXT_WINDOW=8192
MODEL_LOCAL_OPTIMIZED_MAX_OUTPUT_TOKENS=600
MODEL_LOCAL_OPTIMIZED_TOP_P=0.9
MODEL_LOCAL_OPTIMIZED_SEED=42
LOCAL_LLM_BENCHMARK_REPETITIONS=3

DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PRICE_CURRENCY=USD

# Google Cloud Console -> OAuth client (Web application).
# Add the redirect URI below to Authorized redirect URIs.
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/google-calendar/oauth/callback
# IANA timezone used for natural-language times, Calendar events and daily/weekly summaries.
PLANNER_TIMEZONE=Asia/Omsk

MODEL_FLASH_TITLE=DeepSeek Flash
MODEL_FLASH_BASE_URL=https://api.deepseek.com
MODEL_FLASH_NAME=deepseek-v4-flash
MODEL_FLASH_INPUT_PRICE_PER_1M=0.14
MODEL_FLASH_OUTPUT_PRICE_PER_1M=0.28
MODEL_FLASH_SOURCE_URL=https://api-docs.deepseek.com/quick_start/pricing-details-usd

MODEL_GEMINI_TITLE=Слабая: Gemini 3.5 Flash-Lite
MODEL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MODEL_GEMINI_NAME=gemini-3.5-flash-lite
MODEL_GEMINI_INPUT_PRICE_PER_1M=0
MODEL_GEMINI_OUTPUT_PRICE_PER_1M=0
MODEL_GEMINI_SOURCE_URL=https://ai.google.dev/gemini-api/docs/pricing

MODEL_PRO_TITLE=Сильная: DeepSeek V4 Pro
MODEL_PRO_BASE_URL=https://api.deepseek.com
MODEL_PRO_NAME=deepseek-v4-pro
MODEL_PRO_INPUT_PRICE_PER_1M=0.435
MODEL_PRO_OUTPUT_PRICE_PER_1M=0.87
MODEL_PRO_SOURCE_URL=https://api-docs.deepseek.com/quick_start/pricing-details-usd
